# Variables de la app web. En Vercel: Settings → Environment Variables. Local: copiar a .env.local.
# Nunca subas valores reales al repo.

# Anthropic
ANTHROPIC_API_KEY=

# Auth.js (frontend) y validación de sesión (backend). ≥ 32 caracteres: openssl rand -base64 48
AUTH_SECRET=

# Login con Google (Google Cloud Console → Credenciales → ID de cliente OAuth, tipo "Aplicación web").
# URI de redireccionamiento autorizado: https://<tu-dominio>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Postgres (host con -pooler). Un rol por uso: escritura del esquema app y solo lectura por perfil.
DB_URL_APP=
DB_URL_VENTAS=

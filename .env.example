# Variables de la app web. En Vercel: Settings → Environment Variables. Local: copiar a .env.local.
# Nunca subas valores reales al repo.

# Anthropic
ANTHROPIC_API_KEY=

# Login con Google: lo hace panacea-produccion-backend, igual que en panacea-compras.
# AUTH_SECRET es el mismo valor que SECRET_KEY de ese backend (valida el JWT de la sesión).
# En ese backend, FRONTEND_URLS tiene que incluir https://<tu-dominio>/auth/callback
AUTH_SECRET=
# Opcional (este es el valor por defecto)
AUTH_BACKEND_URL=https://panacea-produccion-backend.vercel.app
# Opcional: URL pública de esta app, si la que ve Next no es la real
APP_URL=

# Postgres (host con -pooler). Un rol por uso: escritura del esquema app y solo lectura por perfil.
DB_URL_APP=
DB_URL_VENTAS=

# Variables externas (clima). Open-Meteo es gratis sin clave solo para uso no comercial.
# Con plan comercial, poner la clave: se usan los hosts customer-*.open-meteo.com.
OPEN_METEO_API_KEY=

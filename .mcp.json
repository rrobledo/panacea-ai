{
  "mcpServers": {
    "ventas-db": {
      "type": "stdio",
      "command": ".venv/bin/python",
      "args": ["mcp_server/server.py"],
      "env": {
        "DATABASE_URL": "${DATABASE_URL}",
        "SALES_TABLE": "public.panacea_sales_v2",
        "MAX_FILAS": "500",
        "TIMEOUT_SEG": "60"
      }
    },
    "open-meteo": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "open-meteo-mcp-server@2.5.6"]
    }
  }
}
